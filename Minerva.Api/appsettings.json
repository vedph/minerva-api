{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": "Debug",
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "api.log",
          "rollingInterval": "Day"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "Destructure": [
      {
        "Name": "ToMaximumDepth",
        "Args": { "maximumDestructuringDepth": 4 }
      },
      {
        "Name": "ToMaximumStringLength",
        "Args": { "maximumStringLength": 100 }
      },
      {
        "Name": "ToMaximumCollectionCount",
        "Args": { "maximumCollectionCount": 10 }
      }
    ],
    "Properties": {
      "Application": "Minerva"
    }
  },
  "AllowedHosts": "*",
  "AllowedOrigins": [
    "http://localhost:4200"
  ],
  "ConnectionStrings": {
    "Default": "User ID=postgres;Password=postgres;Host=localhost;Port=5432;Database={0};Command Timeout=180"
  },
  "DatabaseName": "pythia",
  "SeedDelay": 0,
  "Reader": {
    "IsFullTextDisabled": true
  },
  "SearchExport": {
    "MaxRows": 10000
  },
  "ForwardedHeaders": {
    "KnownProxies": []
  },
  "Jwt": {
    "Issuer": "https://pythia.azurewebsites.net",
    "Audience": "https://www.fusisoft.it",
    "SecureKey": "7W^3*y5@a!3%5Wu4xzd@au5Eh9mdFG6%WmzQpjDEB8#F5nXT"
  },
  "RateLimit": {
    "IsDisabled": true,
    "PermitLimit": 100,
    "QueueLimit": 0,
    "TimeWindow": "00:01:00"
  },
  "Messaging": {
    "AppName": "Minerva API",
    "ApiRootUrl": "https://somewhere/api/",
    "AppRootUrl": "https://somewhere/swagger/index.html",
    "SupportEmail": "support@somewhere.org"
  },
  "Mailer": {
    "IsEnabled": false,
    "SenderEmail": "noreply@somewhere.org",
    "SenderName": "Minerva API",
    "Host": "host",
    "Port": 587,
    "UseSsl": true,
    "UserName": "username",
    "Password": "password",
    "TestRecipient": "tester@somewhere.org",
    "Recipients": [ "myself@somewhere.org" ]
  },
  "HasTestEndpoints": false
}
