{
  "Plugs": [
    {
      "Id": "text-filter-plug.string"
    },
    {
      "Id": "text-filter-plug.string-builder"
    }
  ],
  "Stepper": {
    "Id": "stage-target-stepper.file"
  },
  "Stages": [
    {
      "Name": "by-file: dots1",
      "Reader": {
        "Id": "piped-text-reader.file-content"
      },
      "Writer": {
        "Id": "piped-text-writer.file"
      },
      "Filters": [
        {
          "Id": "text-filter.xml.scoped-replacer",
          "Options": {
            "Namespaces": ["tei=http://www.tei-c.org/ns/1.0"],
            "ScopeTags": ["tei:abbr", "tei:num", "tei:email", "tei:date"],
            "IsInverted": true,
            "Replacements": [
              {
                "Source": "\\.(\\d+)",
                "Target": "․$1",
                "IsPattern": true
              },
              {
                "Source": "(>\\s*\\d)\\.",
                "Target": "$1․",
                "IsPattern": true
              }
            ]
          }
        }
      ]
    },
    {
      "Name": "by-file: dots2",
      "Reader": {
        "Id": "piped-text-reader.file-content"
      },
      "Writer": {
        "Id": "piped-text-writer.file"
      },
      "Filters": [
        {
          "Id": "text-filter.xml.scoped-replacer",
          "Options": {
            "Namespaces": ["tei=http://www.tei-c.org/ns/1.0"],
            "ScopeTags": ["tei:abbr", "tei:num", "tei:email", "tei:date"],
            "IsInverted": true,
            "Replacements": [
              {
                "Source": "(․\\d+)\\.",
                "Target": "$1․",
                "IsPattern": true
              },
              {
                "Source": "(?<!xml)([.,;:?!])([^\\s\\d<])",
                "Target": "$1 $2",
                "IsPattern": true,
                "Repetitions": 1
              },
              {
                "Source": "\\s+([.,;:?!]\\s+)",
                "Target": "$1",
                "IsPattern": true,
                "Repetitions": 1
              },
              {
                "Source": "</TEI>\\s+",
                "Target": "</TEI>",
                "IsPattern": true,
                "Repetitions": 1
              },
              {
                "Source": "([$£€])\\.(\\s*)(\\d)",
                "Target": "$1․$2$3",
                "IsPattern": true,
                "Repetitions": 1
              }
            ]
          }
        }
      ]
    },
    {
      "Name": "by-line: misc.",
      "Reader": {
        "Id": "piped-text-reader.file-content"
      },
      "Writer": {
        "Id": "piped-text-writer.file"
      },
      "Filters": [
        {
          "Id": "text-filter.str.replacer",
          "Options": {
            "Replacements": [
              {
                "Source": " ",
                "Target": " "
              },
              {
                "Source": "(...)",
                "Target": "(…)"
              },
              {
                "Source": "[...]",
                "Target": "[…]"
              },
              {
                "Source": "“\\s+",
                "Target": "“",
                "IsPattern": true,
                "Repetitions": 1
              },
              {
                "Source": "\\s+”",
                "Target": "”",
                "IsPattern": true,
                "Repetitions": 1
              },
              {
                "Source": "\\s+%",
                "Target": "%",
                "IsPattern": true,
                "Repetitions": 1
              },
              {
                "Source": "\\s+\\)",
                "Target": ")",
                "IsPattern": true,
                "Repetitions": 1
              },
              {
                "Source": "\\(\\s+",
                "Target": "(",
                "IsPattern": true,
                "Repetitions": 1
              },
              {
                "Source": "Æ",
                "Target": "AE"
              },
              {
                "Source": "æ",
                "Target": "ae"
              },
              {
                "Source": "Œ",
                "Target": "OE"
              },
              {
                "Source": "œ",
                "Target": "oe"
              },
              {
                "Source": "ɶ",
                "Target": "OE"
              },
              {
                "Source": "ﬀ",
                "Target": "ff"
              },
              {
                "Source": "ﬁ",
                "Target": "fi"
              },
              {
                "Source": "ﬂ",
                "Target": "fl"
              },
              {
                "Source": "ﬃ",
                "Target": "ffi"
              },
              {
                "Source": "ﬄ",
                "Target": "ffl"
              },
              {
                "Source": "ﬅ",
                "Target": "st"
              },
              {
                "Source": "ﬆ",
                "Target": "st"
              },
              {
                "Source": "!)",
                "Target": "¡)"
              },
              {
                "Source": "?)",
                "Target": "¿)"
              },
              {
                "Source": "A’",
                "Target": "À"
              },
              {
                "Source": "E’",
