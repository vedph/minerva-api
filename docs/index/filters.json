{
  "Plugs": [
    {
      "Id": "text-filter-plug.string"
    },
    {
      "Id": "text-filter-plug.string-builder"
    }
  ],
  "Stepper": {
    "Id": "stage-target-stepper.file"
  },
  "Stages": [
    {
      "Name": "by-file: dots1",
      "Reader": {
        "Id": "piped-text-reader.file-content"
      },
      "Writer": {
        "Id": "piped-text-writer.file"
      },
      "Filters": [
        {
          "Id": "text-filter.xml.scoped-replacer",
          "Options": {
            "ScopeTags": ["tei:abbr", "tei:num"],
            "IsInverted": true,
            "Replacements": [
              {
                "Source": "\\.(\\d+)",
                "Target": "․$1",
                "IsPattern": true
              },
              {
                "Source": "(>\\s*\\d)\\.",
                "Target": "$1․",
                "IsPattern": true
              }
            ]
          }
        }
      ]
    },
    {
      "Name": "by-file: dots2",
      "Reader": {
        "Id": "piped-text-reader.file-content"
      },
      "Writer": {
        "Id": "piped-text-writer.file"
      },
      "Filters": [
        {
          "Id": "text-filter.xml.scoped-replacer",
          "Options": {
            "ScopeTags": ["tei:abbr", "tei:num"],
            "IsInverted": true,
            "Replacements": [
              {
                "Source": "(․\\d+)\\.",
                "Target": "$1․",
                "IsPattern": true
              }
            ]
          }
        }
      ]
    },
    {
      "Name": "by-line: misc.",
      "Reader": {
        "Id": "piped-text-reader.file-line"
      },
      "Writer": {
        "Id": "piped-text-writer.file"
      },
      "Filters": [
        {
          "Id": "text-filter.str.replacer",
          "Options": {
            "Replacements": [
              {
                "Source": "!)",
                "Target": "¡)"
              },
              {
                "Source": "?)",
                "Target": "¿)"
              },
              {
                "Source": "A’",
                "Target": "À",
                "IsPattern": true,
                "Repetitions": 1
              },
              {
                "Source": "E’",
                "Target": "È",
                "IsPattern": true,
                "Repetitions": 1
              },
              {
                "Source": "I’",
                "Target": "Ì",
                "IsPattern": true,
                "Repetitions": 1
              },
              {
                "Source": "O’",
                "Target": "Ò",
                "IsPattern": true,
                "Repetitions": 1
              },
              {
                "Source": "U’",
                "Target": "Ù",
                "IsPattern": true,
                "Repetitions": 1
              },
              {
                "Source": "’",
                "Target": "'",
                "Repetitions": 1
              }
            ]
          }
        }
      ]
    }
  ]
}
